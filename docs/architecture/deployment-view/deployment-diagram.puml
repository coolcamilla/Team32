@startuml deployment-diagram
title Operation: EarthCore - Deployment View

skinparam wrapWidth 200

node "Development Machine\n(team member)" as devbox {
  artifact "Unity Editor 6000.4.10f1\nproject (source/)" as editor
}

node "GitHub Actions\nCI Runner (ubuntu-latest)" as ci {
  artifact "Unity Editor 6000.4.10f1\n(headless, pinned)" as ciunity
  artifact "Build pipeline\n(Windows + Linux targets)" as buildpipeline
}

cloud "GitHub" as github {
  artifact "releases/ folder\n(committed ZIP archives)" as releasesfolder
  artifact "GitHub Releases\n(SemVer-tagged, e.g. v0.4.0)" as ghrelease
}

cloud "itch.io" as itchio {
  artifact "Operation: EarthCore\npublic game page" as itchpage
}

node "Customer / Player Machine\n(Windows)" as winmachine {
  artifact "MVP_vX.Y.Z.zip\n(unzipped)" as winbuild
  artifact "TheMoleProject2D.exe" as winexe
}

node "Customer / Player Machine\n(Linux)" as linuxmachine {
  artifact "MVP_vX.Y.Z.zip\n(unzipped)" as linuxbuild
  artifact "LinuxBuild.x86_64\n(chmod +x)" as linuxexe
}

devbox --> ci : push / PR triggers workflow
ci --> ciunity : installs pinned\nEditor version
ciunity --> buildpipeline : runs tests,\nbuilds player targets
buildpipeline --> releasesfolder : Windows + Linux\nbuild artifacts (manual\nteam upload after Sprint)
buildpipeline --> ghrelease : attached to\ntagged release
buildpipeline --> itchpage : manual upload\n(added Sprint 5)

releasesfolder --> winbuild : download\n(local setup instructions)
releasesfolder --> linuxbuild : download\n(local setup instructions)
ghrelease --> winbuild : download\n(release asset)
ghrelease --> linuxbuild : download\n(release asset)
itchpage --> winbuild : download\n(itch.io page)
itchpage --> linuxbuild : download\n(itch.io page)

winbuild --> winexe : unzip, run
linuxbuild --> linuxexe : unzip,\nchmod +x, run

note bottom of winmachine
  No network connection required at runtime.
  No backend service, database, or external API.
  Game state persists locally via SaveManager
  (JSON file at Application.persistentDataPath).
  Save files are local-only; no cross-device sync.
end note

note bottom of linuxmachine
  Same standalone model as Windows.
  Player-facing access path is fully offline
  once the build is downloaded.
end note

@enduml
