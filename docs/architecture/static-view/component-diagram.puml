@startuml component-diagram
title Operation: EarthCore - Component Diagram (Static View)

skinparam componentStyle rectangle
skinparam wrapWidth 200
skinparam maxMessageSize 200

actor Player as player

package "Unity Platform" {
  [Unity Input System] as input
  [Unity Physics2D] as physics
  [Unity Animator] as animator_engine
  [Unity Tilemap] as tilemap_engine
}

package "Game Management" as gm {
  [GameInitializer] as gameinit
  [GridGenerator\n(singleton)] as gridgen
  [WorldGenerator\n(plain C#)] as worldgen
}

package "Menu System" as menu_pkg {
  [InGameMenuManager] as menumgr
}

package "Player Subsystem" as player_pkg {
  [PlayerMovement] as movement
  [PlayerDig] as dig
  [PlayerStamina] as stamina
  [StaminaLogic\n(plain C#)] as staminalogic
  [PlayerManager\n(MonoBehaviour,\ntracks EquippedItem + Coins)] as playermgr
  [PlayerManagerLogic\n(plain C#)] as playermgrlogic
  [PlayerAnimator\n(singleton)] as playeranim
}

package "Death / Respawn" as death_pkg {
  [DeathController] as deathctrl
  note right of death_pkg
    Subscribes to StaminaLogic.OnDeath.
    On death: shows death screen,
    PlayerMovement.HandleDeath(),
    waits 10s, then
    InventoryManager.ClearResources()
    + respawns player and stamina.
    Coins are NOT cleared - they live
    on PlayerManager, not InventoryManager.
  end note
}

package "Blocks / World" as blocks_pkg {
  [BlockBehaviour] as block
  [BlockBehaviourLogic\n(plain C#)] as blocklogic
  [BlockTypeData\n(ScriptableObject,\ndrop table incl. Coin)] as blockdata
}

package "Items" as items_pkg {
  [Item\n(ScriptableObject)] as item
  [CollectableBehaviour] as collectable
  [TypeToItemData] as typetodata
  [TypeToPrefab\n(incl. ItemType.Coin)] as typetoprefab
}

package "Inventory Subsystem" as inv_pkg {
  [InventoryManager\n(resources only -\nnot coins)] as invmgr
  [InventoryLogic\n(plain C#)] as invlogic
}

package "Crafting Subsystem" as craft_pkg {
  [CraftManager] as craftmgr
  [CraftLogic\n(plain C#)] as craftlogic
  [CraftTracker] as crafttracker
}

package "Mining Station Subsystem" as mining_pkg {
  [DepositNode] as depositnode
  [MiningStation] as miningstation
  [MiningStationLogic\n(plain C#)] as miningstationlogic
  [StationRecipe\n(ScriptableObject)] as stationrecipe
  [BuildStationUI\n(singleton)] as buildui
}

package "Drill / Layer Subsystem" as drill_pkg {
  [DrillBehaviour] as drillbehaviour
  [DrillLogic\n(plain C#)] as drilllogic
  [Drill / Engine / FuelTank\n(ScriptableObjects)] as drillparts
  [DrillLayer\n(data: DropChances,\nBackgroundTile, ForegroundTile)] as drilllayer
  note right of drill_pkg
    IMPORTANT: DrillBehaviour's Tilemap
    swap (_bgBlocks/_fgBlocks) is a
    COSMETIC change to the small local
    "drill scene" diorama only - it does
    NOT alter the real explorable world.
    The physical dirt/stone layers in the
    actual world are separate and gated
    by the player crafting a stone pickaxe.

    IsStuck() halts ALL drill progress past
    3.5m depth unless Drill, Engine, AND
    FuelTank have each been upgraded at
    least once from their "Basic" tier.
  end note
}

package "Beer / Coin Economy" as beer_pkg {
  [BeerBarrelBehaviour] as beerbarrel
  note right of beer_pkg
    5 coins -> PlayerManager.UpgradeStamina()
    -> PlayerStamina.Upgrade()
    -> permanently +5 MaxStamina.
    No cap visible in current code.
  end note
}

package "UI" as ui_pkg {
  [DepthCounter\n(tracks PLAYER's own\nY-position depth)] as depthcounter
  note right of ui_pkg
    Independent from DrillLogic.Depth.
    Two separate "Depth: X m" displays
    exist: the drill panel's own depth,
    and this player-position-based one.
  end note
}

' --- Player subsystem wiring ---
player --> input : input
movement ..> stamina : requires (RequireComponent)
dig --> playermgr : reads EquippedItem
stamina --> staminalogic : Drain/Regenerate/Upgrade
playermgr --> playermgrlogic : EquippedItem, Coins
playeranim --> dig : OnAnyDig event

' --- Death wiring ---
staminalogic --> deathctrl : OnDeath event
deathctrl --> movement : HandleDeath(), Respawn()
deathctrl --> stamina : Respawn()
deathctrl --> invmgr : ClearResources()

' --- Beer/coin wiring ---
player --> beerbarrel : Interact (trigger zone)
beerbarrel --> playermgr : TrySpendCoins(5),\nUpgradeStamina()

' --- Block / drops ---
dig --> block : TryTakeDamage
block --> blocklogic : damage, drops
blocklogic --> blockdata : reads drop table\n(incl. Coin entries)
block --> typetoprefab : Convert(type)\nincl. Coin prefab
typetoprefab --> collectable : spawned world item
collectable --> invmgr : TryAddItem
collectable ..> playermgr : (if Coin,\nlikely credited to PlayerManager\ninstead - not directly verified)

' --- World generation ---
gameinit --> gridgen : initializes level
gridgen --> worldgen : generates terrain
gridgen --> block : instantiates blocks

' --- Mining stations ---
depositnode --> buildui : ShowUI/HideUI
depositnode --> invmgr : IsEnough / Spend (build cost)
depositnode --> miningstation : Instantiate + Initialize(recipe)
miningstation --> miningstationlogic : Tick(deltaTime)
miningstation --> stationrecipe : reads recipe,\nproducedItemPrefab
stationrecipe --> item : buildCost references

' --- Drill / layer subsystem ---
drillbehaviour --> drilllogic : Tick, TryProcessSecond,\nTryUpdateLayer
drillbehaviour --> invmgr : fuel + upgrade costs\n(Pebbles, Clay, Stick)
drillbehaviour --> drillparts : CurrentDrill/Engine/FuelTank
drillbehaviour --> drilllayer : dequeues next layer\non transition
drillbehaviour --> tilemap_engine : swaps LOCAL drill-scene\ntiles only (cosmetic)
drillbehaviour --> typetoprefab : drops layer resources\nnear the sign

' --- Crafting ---
craftmgr --> craftlogic : TryCraft
craftlogic --> invlogic : spend/add
craftmgr --> crafttracker : IsCrafted

' --- UI ---
depthcounter --> player : reads Transform.position

@enduml
